# On-demand cache revalidation — must match REVALIDATION_SECRET on the public frontend (Vercel).
# Without this, admin saves will NOT immediately reflect on the public site.
REVALIDATION_SECRET=replace-with-a-long-random-secret
# Full URL to the public frontend revalidation endpoint.
# Set to the actual staging/production domain — do not leave as placeholder.
# Example (staging): https://staging.thailandkitchens.com/api/revalidate
# Example (prod):    https://www.thailandkitchens.com/api/revalidate
PUBLIC_FRONTEND_REVALIDATE_URL=https://staging.thailandkitchens.com/api/revalidate
PUBLIC_API_URL=http://127.0.0.1:5000
# Optional — if set, uploads go to Cloudinary instead of local /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OpenAI — blog text drafts + cover image generation (sk-proj-... keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Image model preference (gpt-image-1 recommended; falls back automatically)
