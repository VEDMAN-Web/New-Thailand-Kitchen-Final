NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://127.0.0.1:5000
# Origin only — do not append /api (that caused admin upload 404s).
# Public site origin — used for admin image URL previews (/products/*, /features/*, …)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Varsovia public assets (/home/*, /team/*, …) for admin image previews
# NEXT_PUBLIC_VARSOVIA_FRONTEND_URL=http://localhost:3000

# Public origin for /uploads paths saved into Varsovia CMS (no trailing slash).
# Required for the live Varsovia site to load admin-uploaded images.
# Example: https://your-thailand-api.example.com
# NEXT_PUBLIC_UPLOAD_PUBLIC_URL=http://127.0.0.1:5000

# External Varsovia API.
# Thailand admin JWT gates /varsovia-api; this key is forwarded as x-admin-key.
# Must match Varsovia backend ADMIN_KEY (never commit the real value).
VARSOVIA_API_URL= change-me-must-match-varsovia-API_URL
# Local: VARSOVIA_API_URL=http://127.0.0.1:5000/api
VARSOVIA_ADMIN_KEY=change-me-must-match-varsovia-ADMIN_KEY
