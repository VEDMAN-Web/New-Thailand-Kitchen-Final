# Copy to .env.local for local development (never commit secrets)

# Same-origin API (recommended for Vercel contact/catalog routes)
NEXT_PUBLIC_API_URL=/api

# Express CMS/API (admin backend) — used to merge products/blogs from CMS
# Local: http://localhost:5000/api
# Production: https://YOUR-API-DOMAIN/api
NEXT_PUBLIC_CMS_API_URL=http://localhost:5000/api

# Host-only backend URL used by Next rewrites (/cms-api → backend)
BACKEND_URL=http://127.0.0.1:5000

# Do not junction `.next` to another drive — Turbopack breaks (react/jsx-runtime).
# Keep the project on a fast local disk for best `npm run dev` speed.

# MongoDB Atlas connection string (required for contact form)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, default: thailandKitchen)
MONGO_DB_NAME=thailandKitchen
